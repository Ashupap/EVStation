# Copy to apps/api/.env and fill in values. Never commit real values.
# Fastify API service (Phase 1: auth, tenants, sites, users).

# HTTP port. 4000 is EVStation's reserved API dev port (ADR-0007); do not
# change this default without updating docs/RUNBOOK.md.
PORT=4000
LOG_LEVEL=info
NODE_ENV=development

# ── Database (one connection role per job; never share) ──────────────────
# Runtime role: LOGIN, NOBYPASSRLS, owns nothing. All tenant data access
# goes through this role with RLS + the per-request tenant GUC.
DATABASE_URL_APP=postgres://evstation_app:CHANGE_ME@localhost:5432/evstation
# Table owner: LOGIN, NOBYPASSRLS; owns the schema/tables and can apply
# migrations. Never used by the API runtime.
DATABASE_URL_OWNER=postgres://evstation_owner:CHANGE_ME@localhost:5432/evstation
# Bootstrap/superuser: used only to create roles and seed. Never used by
# the API runtime or by ordinary migrations.
DATABASE_URL_MIGRATOR=postgres://evstation:CHANGE_ME@localhost:5432/evstation

# ── Keycloak / OIDC (API verifies bearer tokens; never proxies login) ────
OIDC_ISSUER=http://localhost:8180/realms/evstation
OIDC_AUDIENCE=evstation-api
# Optional override; derived from OIDC_ISSUER when unset.
# OIDC_JWKS_URI=http://localhost:8180/realms/evstation/protocol/openid-connect/certs

# ── Phase 2 (adapter only; leave unset in Phase 1) ───────────────────────
# CITRINEOS_HTTP_BASE_URL=http://localhost:8088
