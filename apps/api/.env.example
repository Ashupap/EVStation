# Copy to .env and fill in values. Never commit real values.
# Fastify API service (populated in later phases per PRD section 4)

# HTTP port the Fastify server listens on
PORT=8000
# pino log level
LOG_LEVEL=info

# CitrineOS HTTP API (called only through packages/csms-adapter)
# See docs/RUNBOOK.md for the full port map.
CITRINEOS_HTTP_BASE_URL=http://localhost:8080

# Keycloak OIDC provider (thin auth module, later phases)
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=evstation
# Replaced in Phase 1 with a client-credentials/flow-specific secret variable
KEYCLOAK_CLIENT_ID=dashboard
