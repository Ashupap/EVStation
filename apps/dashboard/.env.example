# Copy to .env.local and fill in values. Never commit real values.
# Next.js operator dashboard (populated in later phases per PRD section 4)

# Base URL of our API service
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Keycloak (OIDC, Authorization Code + PKCE, public client; no secrets here)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=evstation
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=dashboard
