# Copy to apps/dashboard/.env.local and fill in values. Never commit real
# values. Phase 1 dashboard is a BFF: the browser never calls the API or
# Keycloak directly, and tokens never leave the server.

# Dev server port. 3200 is EVStation's reserved dashboard dev port (ADR-0007).
PORT=3200

# Server-side API base URL (not exposed to the browser).
API_BASE_URL=http://localhost:4000

# Keycloak: confidential client + Authorization Code + PKCE (ADR-0013).
# The secret is generated into infra/compose/.env by pnpm dev:stack and
# applied to the realm by the dev seeding script; it is never committed.
OIDC_ISSUER=http://localhost:8180/realms/evstation
OIDC_CLIENT_ID=dashboard
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_REDIRECT_URI=http://localhost:3200/auth/callback

# Server-side session (opaque cookie references an in-process store).
SESSION_COOKIE_NAME=evstation_session
SESSION_ABSOLUTE_TTL_SECONDS=28800
SESSION_IDLE_TTL_SECONDS=1800
SESSION_STORE_MAX_ENTRIES=10000
LOGIN_STORE_MAX_ENTRIES=5000
# Set true only behind HTTPS (production); switches cookies to __Host-.
COOKIE_SECURE=false

# Number of trusted reverse proxies in front of the dashboard (1-10), or
# false when the dashboard is directly exposed (dev-only shared IP bucket).
# Production requires a hop count. The selected X-Forwarded-For entry is
# counted from the right; the edge proxy must overwrite inbound XFF.
TRUST_PROXY=false
