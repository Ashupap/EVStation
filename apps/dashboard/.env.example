# Copy to .env.local and fill in values. Never commit real values.
# Next.js operator dashboard (populated in later phases per PRD section 4)

# Dev server port. 3200 is EVStation's reserved dashboard dev port (ADR-0007).
# If it changes, update the Keycloak realm redirect URIs/web origins to match
# (infra/compose/keycloak/evstation-realm.json) — see RUNBOOK 'Changing dev ports'.
PORT=3200

# Base URL of our API service (Phase 1 reserves 4000 for it)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Keycloak (OIDC, Authorization Code + PKCE, public client; no secrets here)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=evstation
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=dashboard
