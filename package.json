{
  "name": "evstation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.2"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "install:ci": "pnpm install --frozen-lockfile",
    "dev:bootstrap": "node scripts/bootstrap-citrineos.mjs",
    "dev:stack": "pnpm dev:bootstrap && node scripts/dev-stack.mjs up",
    "dev:stack:down": "node scripts/dev-stack.mjs down",
    "dev:stack:logs": "node scripts/dev-stack.mjs logs",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "description": "EV charging Central Management System (CMS) for India, built on CitrineOS.",
  "repository": {
    "type": "git",
    "private": true
  }
}
