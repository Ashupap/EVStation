{
  "name": "evstation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.2"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "health": "node scripts/health.mjs",
    "health:json": "node scripts/health.mjs --json",
    "smoke": "node tools/smoke.mjs",
    "install:ci": "pnpm install --frozen-lockfile",
    "dev:bootstrap": "node scripts/bootstrap-citrineos.mjs",
    "dev:stack": "pnpm dev:bootstrap && node scripts/dev-stack.mjs up",
    "dev:stack:down": "node scripts/dev-stack.mjs down",
    "dev:stack:logs": "node scripts/dev-stack.mjs logs",
    "prepare": "husky",
    "db:roles": "node packages/db/scripts/roles.mjs",
    "db:migrate": "node packages/db/scripts/migrate.mjs",
    "db:seed": "node packages/db/scripts/seed.mjs",
    "test:db": "vitest run packages/db/test",
    "test:ocpp:production-like": "node scripts/ocpp-production-like-test.mjs",
    "worker": "pnpm --filter @evstation/worker start",
    "worker:dev": "pnpm --filter @evstation/worker dev",
    "test:e2e:phase2b": "node tools/phase2b-e2e.mjs",
    "test:e2e:phase2c-latency": "node tools/phase2c-latency.mjs",
    "test:e2e:phase2c-load": "node tools/phase2c-load.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "pg": "8.23.1",
    "amqplib": "2.2.0"
  },
  "description": "EV charging Central Management System (CMS) for India, built on CitrineOS.",
  "repository": {
    "type": "git",
    "private": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "cpu-features",
      "protobufjs",
      "ssh2"
    ]
  }
}
