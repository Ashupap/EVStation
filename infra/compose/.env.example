# Copy to infra/compose/.env before running pnpm dev:stack.
# ⚠ ALL VALUES BELOW ARE DEVELOPMENT-ONLY. Never use them anywhere real.
#   This file is a template: no real secrets live in this repository.

# ── Our database (evstation) ──────────────────────────────────────────────
OUR_DB_PASSWORD=dev_only_evstation_db_password

# ── Keycloak bootstrap admin (Keycloak 26.x) ─────────────────────────────
# Used only to create the initial admin account when the stack first starts.
KC_BOOTSTRAP_ADMIN_USERNAME=dev_admin
KC_BOOTSTRAP_ADMIN_PASSWORD=dev_only_admin_password
