# Copy to infra/compose/.env before running pnpm dev:stack.
# ⚠ ALL VALUES BELOW ARE DEVELOPMENT-ONLY. Never use them anywhere real.
#   This file is a template: no real secrets live in this repository.
#   pnpm dev:stack auto-creates .env with random dev secrets when missing,
#   and appends any keys added in later phases (without printing values).

# ── Configurable host ports (defaults; any value used must stay free) ────
# CitrineOS HTTP + Swagger. 8080 and 3000 are permanently reserved on
# development hosts that use this template — never move defaults onto them.
CITRINE_HTTP_HOST_PORT=8088
# Our PostGIS database (our-db)
OUR_DB_HOST_PORT=5432
# Keycloak HTTP and management ports
KEYCLOAK_HTTP_HOST_PORT=8180
KEYCLOAK_MGMT_HOST_PORT=8181

# ── Our database (evstation) ──────────────────────────────────────────────
# Bootstrap superuser (role creation, seeding only).
OUR_DB_PASSWORD=dev_only_evstation_db_password
# Table owner (LOGIN, NOBYPASSRLS; owns schema and applies migrations).
OUR_DB_OWNER_PASSWORD=dev_only_evstation_owner_password
# API runtime (LOGIN, NOBYPASSRLS; owns nothing).
OUR_DB_APP_PASSWORD=dev_only_evstation_app_password
# Ingestion worker DB role (LOGIN, NOBYPASSRLS; EXECUTE-only ingestion functions).
OUR_DB_INGEST_PASSWORD=dev_only_evstation_ingest_password
# Background jobs DB role (LOGIN, NOBYPASSRLS; EXECUTE-only job functions).
OUR_DB_JOBS_PASSWORD=dev_only_evstation_jobs_password
# RabbitMQ worker login used by apps/worker (read-only on evstation.ingest).
OUR_AMQP_WORKER_PASSWORD=dev_only_amqp_worker_password
# Monitoring-only RabbitMQ user for queue-depth metrics (tag: monitoring).
OUR_AMQP_MONITOR_PASSWORD=dev_only_amqp_monitor_password

# ── Keycloak bootstrap admin (Keycloak 26.x) ─────────────────────────────
# Used only to create the initial admin account when the stack first starts.
KC_BOOTSTRAP_ADMIN_USERNAME=dev_admin
# Dev secret (random value is generated by pnpm dev:stack on first run).
KC_BOOTSTRAP_ADMIN_PASSWORD=dev_only_admin_password

# ── Keycloak dashboard client (confidential, server-side only) ───────────
# Applied to the realm by the dev seeding script; read by the dashboard from
# its own .env.local. Never expose to the browser.
KC_DASHBOARD_CLIENT_SECRET=dev_only_dashboard_client_secret
KC_CSMS_PROVISIONER_CLIENT_SECRET=dev_only_csms_provisioner_secret
KC_CSMS_READER_CLIENT_SECRET=dev_only_csms_reader_secret

# ── Hasura (CitrineOS data API at :8090) ─────────────────────────────────
# Dev secret (random value is generated by pnpm dev:stack on first run).
# The operator-UI profile reads the same variable via compose, so UI and
# scripts stay consistent; scripts read it from infra/compose/.env, never
# hardcode it.
HASURA_ADMIN_SECRET=dev_only_hasura_admin_secret
